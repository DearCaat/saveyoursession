{
  "hooks": {
    "SessionEnd": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$CLAUDE_PLUGIN_ROOT\" ]; then python3 \"$CLAUDE_PLUGIN_ROOT/hooks/sync_claude_session.py\" || python \"$CLAUDE_PLUGIN_ROOT/hooks/sync_claude_session.py\"; fi",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "if [ -n \"$PLUGIN_ROOT\" ]; then python3 \"$PLUGIN_ROOT/hooks/sync_codex_session.py\" || python \"$PLUGIN_ROOT/hooks/sync_codex_session.py\"; fi",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
